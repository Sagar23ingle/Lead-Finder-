# Google Maps Platform / Places API Key (Required for live business discovery)
# Obtain from: https://console.cloud.google.com/ (Enable "Places API (New)")
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API Key (Optional Free Tier from https://aistudio.google.com/)
# If omitted, the built-in Local Opportunity & Audit Engine handles 100% of the workflow for FREE.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Credentials (Optional: if omitted, local persistent storage is used automatically)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-Side Rate Limiting Configuration (Requests per 15-minute sliding window)
RATE_LIMIT_SEARCH=30
RATE_LIMIT_ANALYZE=25
RATE_LIMIT_ENRICH=25
RATE_LIMIT_EXPORT=20
